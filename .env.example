# Copy this file to ".env" at the project root and fill in real values.
# NEVER commit real secrets to the repository.

# MongoDB connection string
DB_URI=mongodb://localhost:27017/sarhne

# Server port
PORT=3000

# AES key used to encrypt/decrypt the phone field (crypto-js)
ENCRYPTED_KEY=change-me-encrypted-key

# bcrypt salt rounds for password hashing
SALT=10

# Public base URL used in e-mails (prevents Host-header injection).
# e.g. http://localhost:3000 in development, https://api.example.com in production
APP_URL=http://localhost:3000

# Gmail SMTP credentials (use an App Password, not your normal password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password

# JWT signing secrets — use long, random values (different per environment)
JWT_SECRET_KEY=change-me-jwt-key
JWT_SECRET_ACCESS=change-me-jwt-access
JWT_SECRET_REFRESH=change-me-jwt-refresh